UID=1000
GID=1000

ENVIRONMENT=development

XDG_CACHE_HOME=/tmp/.cache
HOME=/tmp

# db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=vroomly-db
DB_PORT=5432
DB_NAME=vroomly

EXPOSE_DB_PORT=5477

# backend
BACKEND_PORT=8077
BACKEND_URL=http://vroomly-backend:${BACKEND_PORT}

# backend-port, выставляемый наружу (для доступа к Swagger)
EXPOSE_BACKEND_PORT=8077

LM_STUDIO_BASE_URL=http://host.docker.internal:1234

# Конфиг libretranslate
LIBRETRANSLATE_HOST=vroomly-translate
LIBRETRANSLATE_PORT=5000

# compose
COMPOSE_PROFILES=vr-backend

# Python
PYTHONUNBUFFERED=1
PYTHONPATH=/app

# frontend

# для работы HMR в Windows выставить этот параметр в true
VITE_USE_POLLING=false
