# db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5477
DB_NAME=postgres

# backend
BACKEND_PORT=8077

# compose

# В проекте есть несколько определенных профилей для запуска приложения в докере
# ht-backend - запускает только БД. Бекенд запускается руками в режиме для упрощенной отладки
# ht-frontend - запускает БД и бекенд в контейнере
COMPOSE_PROFILES=ht-backend
