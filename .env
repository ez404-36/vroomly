# db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5477
DB_NAME=postgres

# backend
BACKEND_PORT=8077

# compose

# В проекте есть несколько определенных профилей для запуска приложения в докере
# vr - Запуск всех сервисов в контейнерах
# vr-backend-local - запускает всё в контейнере, кроме бекенда. Миграции так же запускаются вручную
COMPOSE_PROFILES=vr
